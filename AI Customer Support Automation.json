        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a customer support triage system.\n\nYour job is to analyze a customer's support request and extract structured information.\n\nYou must identify:\n\n1. request_type\n2. customer_name\n3. urgency\n4. key_issue\n5. recommended_action\n\nUrgency must be exactly one of these three values:\n\nLow\nMedium\nHigh\n\nUse High when the request involves things such as:\n- Account access problems preventing important work\n- Security concerns\n- Service outages\n- Significant time-sensitive business impact\n- Serious customer-impacting problems\n\nUse Medium when:\n- The customer is experiencing a recurring or meaningful problem\n- The problem affects normal use but is not immediately critical\n- The issue needs support attention but is not time-sensitive\n\nUse Low when:\n- The customer has a general question\n- The customer has a minor issue\n- The customer has a feature request\n- The request is not time-sensitive\n\nDo not invent information that the customer did not provide.\n\nReturn only the requested structured information."
            },
            {
              "content": "=Customer Name:\n{{ $json[\"Customer Name\"] }}\n\nCustomer Request:\n{{ $json[\"Support Request\"] }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"request_type\": {\n      \"type\": \"string\"\n    },\n    \"customer_name\": {\n      \"type\": \"string\"\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Low\",\n        \"Medium\",\n        \"High\"\n      ]\n    },\n    \"key_issue\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"request_type\",\n    \"customer_name\",\n    \"urgency\",\n    \"key_issue\",\n    \"recommended_action\"\n  ],\n  \"additionalProperties\": false\n}"
            }
          }
        }
