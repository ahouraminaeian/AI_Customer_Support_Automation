        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional customer support representative.\n\nWrite a concise, professional and helpful response to the customer.\n\nRules:\n\n- Be polite and empathetic.\n- Acknowledge the customer's issue.\n- Directly address the customer's request when possible.\n- Do not invent company policies.\n- Do not invent refunds, credits, deadlines, or technical facts.\n- Do not claim an issue has been resolved unless the provided information confirms that it has been resolved.\n- If the recommended action is escalation, tell the customer that the issue has been referred to the appropriate support team.\n- Keep the response concise.\n- Do not mention AI, language models, automation, prompts, or this workflow.\n- Sign off as \"The Support Team\"."
            },
            {
              "content": "=Customer Name:\n{{ $('On form submission').item.json['Customer Name'] }}\n\nCustomer Email:\n{{ $('On form submission').item.json['Email Address'] }}\n\nOriginal Customer Request:\n{{ $('On form submission').item.json['Support Request'] }}\n\nRequest Type:\n{{ $('OpenAI I').item.json.output[0].content[0].text.request_type }}\n\nUrgency:\n{{ $('OpenAI I').item.json.output[0].content[0].text.urgency }}\n\nKey Issue:\n{{ $('OpenAI I').item.json.output[0].content[0].text.key_issue }}\n\nRecommended Action:\n{{ $('OpenAI I').item.json.output[0].content[0].text.recommended_action }}\n\nWrite the customer-facing response now."
            }
          ]
        },
